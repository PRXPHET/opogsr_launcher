<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:opogsr_launcher.ViewModels"
			 x:DataType="vm:SettingsViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="opogsr_launcher.Views.SettingsView">

			<Design.DataContext>
				<vm:SettingsViewModel/>
			</Design.DataContext>

			<Grid>
				<ScrollViewer>
					<TabControl x:Name="SettingsTabs">
						<TabControl.Background>
							<SolidColorBrush Color="Black" Opacity="0.5"/>
						</TabControl.Background>
					</TabControl>
				</ScrollViewer>
				<Button Name="ButtonSave" Command="{Binding SaveSettingsCommand}" CommandParameter="{Binding $self}" IsEnabled="False" Margin="0, 0, 0, 10" HorizontalAlignment="Center" VerticalAlignment="Bottom">
					<TextBlock FontSize="20" Text="Save" />
				</Button>
			</Grid>
</UserControl>
