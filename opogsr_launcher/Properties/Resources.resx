  <data name="r_aa_mode" xml:space="preserve">
    <value>Anti-Aliasing</value>
  </data>
  <data name="r_aa_mode_desc" xml:space="preserve">
    <value>This setting switches the anti-aliasing type. SMAA (Subpixel Morphological Anti-Aliasing), TAA (Temporal Anti-Aliasing), AMD FidelityFX Super Resolution (FSR) 2, and Nvidia DLSS (Deep Learning Super-Sampling) are available. AMD FSR 2 is only available on GTX 10 series graphics cards and above. Nvidia DLSS is available on RTX 20 series graphics cards and above.</value>
  </data>
  <data name="r_ao_mode" xml:space="preserve">
    <value>AO Type</value>
  </data>
  <data name="r_ao_mode_desc" xml:space="preserve">
    <value>This setting controls how the global illumination effect works in the game. You can choose between SSDO (ScreenSpace Directional Occlusion) and GTAO (Ground Truth-based Ambient Occlusion).</value>
  </data>
  <data name="r_ao_quality" xml:space="preserve">
